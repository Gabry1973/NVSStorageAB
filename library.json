{
  "name": "NVSStorageAB",
  "version": "1.0.0",
  "description": "Robust A/B NVS storage for trivially copyable ESP32 structures: CRC32 validation, sequence-based A/B recovery, versioning, migrations, auto-upgrade, write verification and anti-wear.",
  "keywords": "esp32, nvs, preferences, storage, eeprom, settings, crc32, power-fail",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabry1973/NVSStorageAB.git"
  },
  "homepage": "https://github.com/Gabry1973/NVSStorageAB",
  "authors": [
    {
      "name": "Gabriele Bordignon",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "NVSStorageAB.h",
  "export": {
    "exclude": [
      ".pio",
      ".vscode",
      "test",
      "tools",
      "platformio.ini"
    ]
  },
  "examples": [
    {
      "name": "BasicSettings",
      "base": "examples/BasicSettings",
      "files": [
        "BasicSettings.ino"
      ]
    },
    {
      "name": "PowerFailData",
      "base": "examples/PowerFailData",
      "files": [
        "PowerFailData.ino"
      ]
    },
    {
      "name": "VersionUpgrade",
      "base": "examples/VersionUpgrade",
      "files": [
        "VersionUpgrade.ino"
      ]
    }
  ]
}
